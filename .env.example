# LOCAL DEVELOPMENT: copy to .env. For Vercel use DEPLOY_VERCEL.md.
APP_ENV=local
EXECUTION_MODE=local-worker
GEMINI_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=
GEMINI_MAX_RETRIES=0
PROVIDER_TIMEOUT_SECONDS=60
RESEARCH_WORKERS=4
ADAPTIVE_SOURCE_HARD_CAP=60
MAX_SOURCE_CHARS=6500
HADOOP_MODE=local
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=180
MAX_ACTIVE_JOBS=2
MAX_SAVED_JOBS=100
STORAGE_BUDGET_MB=350
MAX_MONTHLY_RUNS=30
# Empty uses SQLite locally; Vercel requires Marketplace PostgreSQL.
DATABASE_URL=
# Required in Vercel: password 16+ characters, session secret 32+ random characters.
WORKSPACE_PASSWORD=
SESSION_SECRET=
DEMO_MODE=false
